# ExperientialLabs OpenAI-compatible API key (required for Live runs).
# This is the secret. Never commit `.env`.
EXPLABS_API_KEY=

# Optional overrides
# Gateway URL is public (not a secret). README env table prints `[REDACTED]`
# for the same value so the markdown table does not trip the secret scan.
# Copy this file to `.env`; do not invent a host.
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# Default: deepseek-v4-flash. Models in the no-temperature denylist (e.g. gpt-6-astra)
# omit temperature automatically; set EXPLABS_MODEL=gpt-6-astra to try.
EXPLABS_MODEL=deepseek-v4-flash
# Force omit temperature for any model (1/true/yes/on). Also auto-retries once
# if the API rejects temperature as an unsupported parameter.
# EXPLABS_OMIT_TEMPERATURE=1

# FastAPI /chat gate. Docker image + Compose set CHAT_REQUIRE_API_KEY=1
# (default-deny on published binds). Local uvicorn: leave unset for open
# local demos, or set a key / CHAT_REQUIRE_API_KEY=1.
CHAT_API_KEY=
# CHAT_REQUIRE_API_KEY=1
# CHAT_ALLOW_UNAUTHENTICATED=1
